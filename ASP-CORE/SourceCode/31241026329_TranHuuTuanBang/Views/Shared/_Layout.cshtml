<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Cuộn Phim là cửa hàng phim dùng để thực hành thương mại điện tử." />
    <title>@ViewData["Title"] · Cuộn Phim</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-head">
        <div class="wrap head">
            <a class="brand" asp-controller="Movies" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">▶</span> Cuộn Phim
            </a>
            <nav class="navlinks" aria-label="Điều hướng chính">
                <a asp-controller="Movies" asp-action="Index">Kho phim</a>
                <a asp-controller="Genres" asp-action="Index">Thể loại</a>
                <partial name="_LoginPartial" />
                <partial name="Summary" />
            </nav>
        </div>
    </header>
    <main class="wrap main" id="main">
        @if (TempData["Notice"] is string notice)
        {
            <p class="notice" role="status">@notice</p>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="wrap foot"><span class="brand">Cuộn Phim</span><span>© @DateTime.Now.Year · 31241026329 · Trần Hữu Tuấn Bằng</span></div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
