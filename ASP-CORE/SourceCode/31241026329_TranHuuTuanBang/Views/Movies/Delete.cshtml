@model Movie
@{
    ViewData["Title"] = "Xóa phim";
}
<a class="back-link" asp-action="Details" asp-route-id="@Model.ID">← Chi tiết phim</a>
<h1>Xóa phim</h1>
<form class="panel form-grid" asp-action="Delete" asp-route-id="@Model.ID" method="post">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <p>Bạn muốn xóa <strong>@Model.Title</strong> khỏi kho phim?</p>
    <button type="submit" class="button">Xác nhận xóa</button>
</form>
